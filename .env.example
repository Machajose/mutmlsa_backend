# Postgres connection string — Render/Railway both give you this
# when you create a free Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "false" only if connecting to a local Postgres without SSL.
DB_SSL=true

# Port the server listens on (Render/Railway set this automatically —
# only needed for local development).
PORT=4000

# Comma-free single URL of your deployed frontend, for CORS.
# Use * during development if this is annoying to keep updated.
FRONTEND_URL=https://your-frontend-url.com

# --- Email notifications (optional) ---
# Get a free API key at https://resend.com — without this, submissions
# are still saved to the database, you just won't get an email ping.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=MUTMLSA Site <onboarding@resend.dev>
NOTIFY_TO_EMAIL=mutmedicallab@gmail.com

# --- Admin access ---
# Shared password for viewing submissions via GET /api/membership and
# GET /api/contact. Pick something only you know.
ADMIN_PASSWORD=changeme
